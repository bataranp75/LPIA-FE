---
/**
 * Button Component - LPIA Design System
 * 
 * Props:
 * - variant: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost'  (default: 'primary')
 * - size: 'sm' | 'md' | 'lg'  (default: 'md')
 * - disabled: boolean (default: false)
 * - href: string — jika diisi, render sebagai <a>
 * - type: 'button' | 'submit' | 'reset'  (default: 'button')
 * - id: string
 * - class: string — tambahan class kustom
 * 
 * Usage:
 * <Button variant="primary">Daftar Sekarang</Button>
 * <Button variant="secondary" size="sm">Lihat Detail</Button>
 * <Button variant="danger" disabled>Hapus</Button>
 * <Button variant="outline" href="/login">Masuk</Button>
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  type = 'button',
  id,
  class: extraClass = '',
} = Astro.props;

// ── Size classes ──────────────────────────────────────────────────
const sizeMap = {
  sm:  'px-4 py-2 text-sm',
  md:  'px-6 py-2.5 text-base',
  lg:  'px-9 py-3.5 text-lg',
};

// ── Variant classes ───────────────────────────────────────────────
// Setiap varian punya:
//   - bg / border / text color
//   - shadow neobrutalist (bukan drop-shadow)
//   - active: translate + shadow-none (efek "ditekan")
const variantMap = {
  primary:
    'bg-primary border-gray-900 text-white ' +
    'shadow-[0_4px_0_0_#1e3a5f] ' +
    'hover:brightness-105 ' +
    'active:shadow-none active:translate-y-[4px]',

  secondary:
    'bg-gray-900 border-gray-900 text-white ' +
    'shadow-[0_4px_0_0_#6b7280] ' +
    'hover:bg-gray-800 ' +
    'active:shadow-none active:translate-y-[4px]',

  outline:
    'bg-white border-gray-900 text-gray-900 ' +
    'shadow-[0_4px_0_0_#1f2937] ' +
    'hover:bg-gray-50 ' +
    'active:shadow-none active:translate-y-[4px]',

  danger:
    'bg-red-500 border-red-900 text-white ' +
    'shadow-[0_4px_0_0_#7f1d1d] ' +
    'hover:bg-red-600 ' +
    'active:shadow-none active:translate-y-[4px]',

  ghost:
    'bg-transparent border-transparent text-primary ' +
    'shadow-none ' +
    'hover:bg-blue-50 ' +
    'active:bg-blue-100',
};

// ── Disabled override ─────────────────────────────────────────────
const disabledClasses = disabled
  ? 'opacity-40 cursor-not-allowed pointer-events-none shadow-none'
  : 'cursor-pointer';

// ── Compose ───────────────────────────────────────────────────────
const base =
  'inline-flex items-center justify-center gap-2 ' +
  'font-black tracking-tight rounded-xl border-[3px] ' +
  'transition-all duration-100 select-none ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

const classes = [
  base,
  sizeMap[size],
  variantMap[variant],
  disabledClasses,
  extraClass,
].join(' ');
---

{href ? (
  <a href={disabled ? undefined : href} id={id} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} id={id} class={classes} disabled={disabled}>
    <slot />
  </button>
)}