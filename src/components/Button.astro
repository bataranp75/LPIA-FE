---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  type = 'button',
  id,
  class: extraClass = '',
} = Astro.props;

const sizeMap = {
  sm: 'h-10 px-4 text-sm',
  md: 'h-11 px-5 text-base',
  lg: 'h-14 px-8 text-base',
};

const variantMap = {
  primary: 'bg-[#0F4C81] text-white hover:bg-[#0A3A63] active:bg-[#0A3A63]',
  secondary: 'bg-[#F5F3ED] text-[#1A1D20] hover:bg-[#E5E4DE] active:bg-[#E5E4DE]',
  outline: 'border border-[#E5E4DE] bg-white text-[#1A1D20] hover:border-[#0F4C81] hover:text-[#0F4C81]',
  danger: 'bg-red-700 text-white hover:bg-red-800 active:bg-red-800',
  ghost: 'bg-transparent text-[#0F4C81] hover:bg-blue-50 active:bg-blue-100',
};

const disabledClasses = disabled
  ? 'cursor-not-allowed pointer-events-none opacity-50'
  : 'cursor-pointer';

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-150 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0F4C81] focus-visible:ring-offset-2';

const classes = [base, sizeMap[size], variantMap[variant], disabledClasses, extraClass].join(' ');
---

{href ? (
  <a href={disabled ? undefined : href} id={id} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} id={id} class={classes} disabled={disabled}>
    <slot />
  </button>
)}