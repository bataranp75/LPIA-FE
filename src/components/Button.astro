---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  type = 'button',
  id,
  class: extraClass = '',
} = Astro.props;

const sizeMap = {
  sm:  'px-4 py-2 text-sm',
  md:  'px-6 py-2.5 text-base',
  lg:  'px-8 py-3 text-lg',
};

// Menggunakan shadow tipis searah warna background
const variantMap = {
  primary:
    'bg-blue-600 text-white shadow-[0_3px_0_0_#1e40af] hover:bg-blue-700 hover:-translate-y-0.5 active:translate-y-[3px] active:shadow-none border border-blue-700',
  secondary:
    'bg-slate-800 text-white shadow-[0_3px_0_0_#0f172a] hover:bg-slate-900 hover:-translate-y-0.5 active:translate-y-[3px] active:shadow-none border border-slate-900',
  outline:
    'bg-white border-2 border-gray-200 text-gray-700 shadow-[0_3px_0_0_#e5e7eb] hover:border-blue-600 hover:text-blue-600 hover:-translate-y-0.5 active:translate-y-[3px] active:shadow-none',
  danger:
    'bg-red-600 text-white shadow-[0_3px_0_0_#991b1b] hover:bg-red-700 hover:-translate-y-0.5 active:translate-y-[3px] active:shadow-none border border-red-700',
  ghost:
    'bg-transparent text-blue-600 shadow-none hover:bg-blue-50 active:bg-blue-100',
};

const disabledClasses = disabled
  ? 'opacity-50 cursor-not-allowed pointer-events-none shadow-none translate-y-0'
  : 'cursor-pointer';

const base =
  'inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-all duration-200 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2';

const classes = [base, sizeMap[size], variantMap[variant], disabledClasses, extraClass].join(' ');
---

{href ? (
  <a href={disabled ? undefined : href} id={id} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} id={id} class={classes} disabled={disabled}>
    <slot />
  </button>
)}