---
// src/components/Carousel.astro
---

<div class="carousel-wrapper relative w-full overflow-hidden rounded-2xl md:rounded-3xl border border-slate-200 shadow-sm bg-slate-100 min-h-[380px] md:min-h-[440px] group">

    <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out h-full absolute inset-0">
        <div class="w-full h-full min-w-full flex items-center justify-center animate-pulse bg-slate-200">
            <div class="text-center">
                <i class="fas fa-spinner fa-spin text-4xl text-slate-400 mb-2"></i>
                <p class="text-slate-500 font-medium text-sm">Memuat Promo...</p>
            </div>
        </div>
    </div>

    <button id="carousel-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 bg-black/20 backdrop-blur-md border border-white/20 rounded-full flex items-center justify-center text-white hover:bg-black/40 transition-all opacity-0 group-hover:opacity-100 focus:outline-none">
        <i class="fas fa-chevron-left text-sm md:text-base"></i>
    </button>

    <button id="carousel-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 bg-black/20 backdrop-blur-md border border-white/20 rounded-full flex items-center justify-center text-white hover:bg-black/40 transition-all opacity-0 group-hover:opacity-100 focus:outline-none">
        <i class="fas fa-chevron-right text-sm md:text-base"></i>
    </button>

    <div id="carousel-dots" class="absolute bottom-5 right-6 flex gap-2.5 z-20">
        </div>
</div>