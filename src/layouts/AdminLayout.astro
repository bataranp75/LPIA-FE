---
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;

const menus = [
    { href: '/admin/dashboard', label: 'Homepage', icon: 'fa-house' },
    { href: '/admin/accounts', label: 'Manajemen Akun', icon: 'fa-users-gear' },
    { href: '/admin/transactions', label: 'Manajemen Transaksi', icon: 'fa-receipt' },
    { href: '/admin/offline-registrations', label: 'Manajemen Pendaftaran Offline', icon: 'fa-clipboard-list' },
    { href: '/admin/courses', label: 'Manajemen Kursus', icon: 'fa-book-open' },
    { href: '/admin/certificates', label: 'Manajemen Sertifikat', icon: 'fa-award' },
    { href: '/admin/landing', label: 'Landing Page', icon: 'fa-palette' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Admin LPIA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body class="min-h-screen bg-slate-50 text-slate-900" style="font-family: 'Montserrat', sans-serif;">
    <div id="admin-sidebar-overlay" class="fixed inset-0 bg-slate-900/40 z-[998] hidden lg:hidden"></div>

    <div class="flex min-h-screen">
        <aside id="admin-sidebar" class="fixed lg:sticky top-0 left-0 z-[999] h-screen w-72 bg-white border-r border-slate-200 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 flex flex-col">
            
            <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                <h1 class="text-2xl font-black text-blue-700">
                    LPIA Admin
                </h1>

                <button id="admin-sidebar-close" class="lg:hidden w-10 h-10 rounded-xl bg-slate-100 text-slate-700">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <nav class="flex-1 py-6">
                {menus.map((menu) => (
                    <a 
                        href={menu.href}
                        class={`flex items-center gap-3 px-6 py-4 text-sm transition admin-menu-link border-r-4 ${isActive(menu.href) ? 'bg-blue-50 text-blue-700 font-black border-blue-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-bold border-transparent'}`}
                        data-href={menu.href}
                    >
                        <i class={`fas ${menu.icon} w-5 text-center ${isActive(menu.href) ? 'text-blue-600' : ''}`}></i>
                        <span>{menu.label}</span>
                    </a>
                ))}
            </nav>

            <div class="p-4 border-t border-slate-100">
                <button id="admin-logout-btn" class="w-full flex items-center gap-3 px-4 py-4 text-red-600 hover:bg-red-50 font-bold text-sm transition">
                    <i class="fas fa-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <main class="flex-1 p-6 lg:p-10">
            <slot />
        </main>
    </div>

    <script>
        import '../scripts/main.js';
    </script>
</body>
</html>