---
import GuruLayout from '../../layouts/GuruLayout.astro';
---

<GuruLayout title="Dashboard Guru">
    <section id="teacher-materials-page">
        <div class="mb-8">
            <p class="text-sm font-bold text-blue-600 mb-2">Dashboard Guru</p>
            <h1 class="text-3xl font-black text-slate-900">Kelola Materi</h1>
            <p class="text-slate-400 mt-2">Pilih kursus yang Anda ampu, lalu kelola modul dan materi di dalamnya.</p>
        </div>

        <div id="teacher-courses-grid" class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5"></div>
    </section>
</GuruLayout>