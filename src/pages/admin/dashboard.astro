---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
    <section id="admin-dashboard-page" class="space-y-10">
        <!-- Header -->
        <header class="flex items-start gap-4">
            <button id="admin-sidebar-toggle" class="lg:hidden w-11 h-11 shrink-0 rounded-xl bg-white border border-slate-200 shadow-sm text-slate-700 hover:bg-slate-100 transition">
                <i class="fas fa-bars"></i>
            </button>

            <div class="flex-1">
                <p id="admin-current-date" class="text-sm font-bold text-blue-600 mb-1">Memuat tanggal...</p>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight">Dashboard Admin</h1>
                <p class="text-slate-500 mt-2">Ringkasan data, statistik dasar, dan akses cepat pengelolaan LMS.</p>
            </div>

            <div class="hidden md:flex items-center gap-3 bg-white border border-slate-200 rounded-2xl px-5 py-4 shadow-sm">
                <div class="w-11 h-11 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-400 font-bold uppercase">Jam Lokal</p>
                    <p id="admin-current-time" class="text-xl font-black text-slate-900">--:--</p>
                </div>
            </div>
        </header>

        <!-- Stats -->
        <section>
            <div class="flex items-center gap-4 mb-5">
                <div class="h-px flex-1 bg-slate-200"></div>
                <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full shadow-sm">
                    <i class="fas fa-chart-simple text-blue-600"></i>
                    <span class="text-sm font-black text-slate-700">Ringkasan Statistik</span>
                </div>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex items-center gap-5">
                    <div class="w-16 h-16 shrink-0 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-bold">Total Siswa</p>
                        <h2 id="stat-total-siswa" class="text-4xl font-black mt-1">0</h2>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex items-center gap-5">
                    <div class="w-16 h-16 shrink-0 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl">
                        <i class="fas fa-chalkboard-user"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-bold">Total Guru</p>
                        <h2 id="stat-total-guru" class="text-4xl font-black mt-1">0</h2>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex items-center gap-5">
                    <div class="w-16 h-16 shrink-0 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-bold">Total Materi</p>
                        <h2 id="stat-total-materi" class="text-4xl font-black mt-1">0</h2>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Access -->
        <section>
            <div class="flex items-center gap-4 mb-5">
                <div class="h-px flex-1 bg-slate-200"></div>
                <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full shadow-sm">
                    <i class="fas fa-bolt text-indigo-600"></i>
                    <span class="text-sm font-black text-slate-700">Akses Cepat</span>
                </div>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <a href="/admin/accounts" class="group relative overflow-hidden rounded-3xl p-7 bg-blue-600 text-white shadow-lg hover:-translate-y-1 transition">
                    <div class="absolute -right-8 -top-8 text-[8rem] opacity-20 group-hover:scale-110 transition">
                        <i class="fas fa-users-gear"></i>
                    </div>

                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center mb-6">
                            <i class="fas fa-users-gear text-2xl"></i>
                        </div>
                        <h3 class="font-black text-xl">Manajemen Akun</h3>
                        <p class="text-sm text-blue-100 mt-2 leading-relaxed">
                            Kelola akun siswa, guru, reset password, hapus akun, dan akses CRUD guru.
                        </p>
                    </div>
                </a>

                <a href="/admin/transactions" class="group relative overflow-hidden rounded-3xl p-7 bg-emerald-600 text-white shadow-lg hover:-translate-y-1 transition">
                    <div class="absolute -right-8 -top-8 text-[8rem] opacity-20 group-hover:scale-110 transition">
                        <i class="fas fa-receipt"></i>
                    </div>

                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center mb-6">
                            <i class="fas fa-receipt text-2xl"></i>
                        </div>
                        <h3 class="font-black text-xl">Log Transaksi</h3>
                        <p class="text-sm text-emerald-100 mt-2 leading-relaxed">
                            Pantau status pembayaran, bukti transfer, dan konfirmasi transaksi siswa.
                        </p>
                    </div>
                </a>

                <a href="/admin/materials" class="group relative overflow-hidden rounded-3xl p-7 bg-amber-500 text-white shadow-lg hover:-translate-y-1 transition">
                    <div class="absolute -right-8 -top-8 text-[8rem] opacity-20 group-hover:scale-110 transition">
                        <i class="fas fa-book-open-reader"></i>
                    </div>

                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center mb-6">
                            <i class="fas fa-book-open-reader text-2xl"></i>
                        </div>
                        <h3 class="font-black text-xl">Manajemen Materi</h3>
                        <p class="text-sm text-amber-100 mt-2 leading-relaxed">
                            Kelola materi, modul, dan konten pembelajaran yang digunakan oleh guru.
                        </p>
                    </div>
                </a>
            </div>
        </section>

        <!-- Basic Statistic -->
        <section>
            <div class="flex items-center gap-4 mb-5">
                <div class="h-px flex-1 bg-slate-200"></div>
                <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full shadow-sm">
                    <i class="fas fa-chart-pie text-emerald-600"></i>
                    <span class="text-sm font-black text-slate-700">Statistik Dasar</span>
                </div>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h2 class="text-xl font-black">Distribusi Pengguna</h2>
                            <p class="text-sm text-slate-500 mt-1">Perbandingan jumlah guru dan siswa.</p>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>

                    <div class="space-y-5">
                        <div>
                            <div class="flex justify-between text-sm font-bold mb-2">
                                <span>Rasio Guru</span>
                                <span id="ratio-guru-label">0%</span>
                            </div>
                            <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                                <div id="ratio-guru-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: 0%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between text-sm font-bold mb-2">
                                <span>Rasio Siswa</span>
                                <span id="ratio-siswa-label">0%</span>
                            </div>
                            <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                                <div id="ratio-siswa-bar" class="h-full bg-blue-500 rounded-full transition-all duration-500" style="width: 0%;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h2 class="text-xl font-black">Catatan Admin</h2>
                            <p class="text-sm text-slate-500 mt-1">Prioritas pengelolaan sistem.</p>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                            <i class="fas fa-circle-check text-emerald-600"></i>
                            <span class="text-sm font-bold text-slate-700">Pastikan role guru dan admin sudah sesuai.</span>
                        </div>

                        <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                            <i class="fas fa-circle-check text-emerald-600"></i>
                            <span class="text-sm font-bold text-slate-700">Cek akses CRUD guru sebelum materi dipublikasikan.</span>
                        </div>

                        <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                            <i class="fas fa-circle-check text-emerald-600"></i>
                            <span class="text-sm font-bold text-slate-700">Pantau transaksi pending secara berkala.</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </section>
</AdminLayout>