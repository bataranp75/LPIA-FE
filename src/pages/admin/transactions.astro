---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Manajemen Transaksi">
    <section id="admin-transactions-page">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
            <div class="flex items-start gap-4">
                <button id="admin-sidebar-toggle" class="lg:hidden w-11 h-11 rounded-xl bg-white border border-slate-200 shadow-sm text-slate-700">
                    <i class="fas fa-bars"></i>
                </button>

                <div>
                    <h1 class="text-3xl font-black text-slate-900">Manajemen Transaksi</h1>
                    <p class="text-slate-500 mt-2">Log seluruh transaksi siswa pada LMS.</p>
                </div>
            </div>

            <div class="flex flex-wrap gap-2">
                <button id="btn-print-transactions" class="px-4 py-3 rounded-2xl bg-slate-900 text-white font-black text-sm hover:bg-slate-800">
                    <i class="fas fa-print mr-2"></i>Cetak PDF
                </button>
                <button id="btn-export-word-transactions" class="px-4 py-3 rounded-2xl bg-blue-600 text-white font-black text-sm hover:bg-blue-700">
                    <i class="fas fa-file-word mr-2"></i>Export Word
                </button>
            </div>
        </div>

        <div class="rounded-2xl overflow-hidden">
            
<!-- Stats cards berdiri sendiri -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-5 mb-6">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold text-slate-400">Pendapatan</p>
        <h2 id="trx-total-revenue" class="text-2xl font-black mt-2">Rp 0</h2>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold text-slate-400">Total Transaksi</p>
        <h2 id="trx-total-count" class="text-2xl font-black mt-2">0</h2>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold text-slate-400">Confirmed</p>
        <h2 id="trx-total-confirmed" class="text-2xl font-black mt-2">0</h2>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold text-slate-400">Course Terlaris</p>
        <h2 id="trx-best-course" class="text-lg font-black mt-2">-</h2>
    </div>
</div>

<!-- Filter juga berdiri sendiri -->
<div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm mb-6 flex flex-col md:flex-row gap-3">
    <input id="transaction-search" placeholder="Cari user, course, order id..." class="flex-1 px-4 py-3 rounded-xl border border-slate-200 outline-none focus:border-blue-500">

    <select id="transaction-status-filter" class="px-4 py-3 rounded-xl border border-slate-200 outline-none focus:border-blue-500">
        <option value="">Semua Status</option>
        <option value="pending">Pending</option>
        <option value="success">Success</option>
        <option value="failed">Failed</option>
        <option value="cancelled">Cancelled</option>
    </select>
</div>

<!-- Hanya tabel yang pakai container border besar -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-slate-100 text-slate-600">
                <tr>
                    <th class="p-4 text-left">User</th>
                    <th class="p-4 text-left">Kursus</th>
                    <th class="p-4 text-left">Order ID</th>
                    <th class="p-4 text-left">Total</th>
                    <th class="p-4 text-left">Status</th>
                    <th class="p-4 text-left">Tanggal</th>
                </tr>
            </thead>
            <tbody id="transactions-table-body" class="divide-y divide-slate-100"></tbody>
        </table>
    </div>
</div>
        </div>
    </section>
</AdminLayout>