---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Button from '../components/Button.astro';

const promoItems = [];
---

<Layout title="LPIA - Kursus Bahasa & Skill">

    <!-- ══════════════════════════════════════════
         HERO — Flex kiri: copy  |  kanan: carousel
    ═══════════════════════════════════════════ -->
    <section class="w-full max-w-7xl mx-auto px-4 md:px-6 pt-24 pb-16 flex flex-col lg:flex-row items-center gap-10 lg:gap-14">

        <!-- KIRI: Headline + CTA -->
        <div class="flex-1 text-center lg:text-left">
            <span class="inline-flex items-center gap-2 bg-yellow-400 border-2 border-gray-900 rounded-full px-4 py-1.5 text-xs font-black text-gray-900 mb-5">
                <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                Kursus Online Terpercaya
            </span>

            <h1 class="text-5xl md:text-6xl font-black text-gray-900 leading-[1.05] tracking-tight mb-5">
                Belajar Jadi <br/>
                <span class="relative inline-block text-primary">
                    Lebih Seru!
                    <span class="absolute -bottom-1 left-0 w-full h-3 bg-yellow-400 -z-10 skew-x-2 rounded-sm"></span>
                </span>
            </h1>

            <p class="text-lg text-gray-500 font-medium mb-8 max-w-md mx-auto lg:mx-0">
                Dapatkan akses materi berkualitas dengan gaya belajar interaktif ala kuis di LPIA.
            </p>

            <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
                <Button variant="primary" size="lg" href="#kursus">
                    <i class="fas fa-rocket"></i> Daftar Sekarang
                </Button>
                <Button variant="outline" size="lg" href="#cara-daftar">
                    Cara Daftar
                </Button>
            </div>
        </div>

        <!-- KANAN: Carousel + Stats dari DB -->
        <div class="flex-1 w-full max-w-xl lg:max-w-none">
            <Carousel items={promoItems} />

            <!-- Stats Bar — diisi real dari API -->
            <div class="mt-4 grid grid-cols-3 gap-3" id="stats-bar">
                <!-- Skeleton loading -->
                <div class="bg-gray-100 border-2 border-gray-200 rounded-2xl px-4 py-3 text-center animate-pulse h-16"></div>
                <div class="bg-gray-100 border-2 border-gray-200 rounded-2xl px-4 py-3 text-center animate-pulse h-16"></div>
                <div class="bg-gray-100 border-2 border-gray-200 rounded-2xl px-4 py-3 text-center animate-pulse h-16"></div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════
         KURSUS SECTION
    ═══════════════════════════════ -->
    <section id="kursus" class="max-w-7xl mx-auto px-4 md:px-6 py-20">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-black text-gray-900 uppercase tracking-tighter">Pilih Kursusmu</h2>
            <div class="h-2 w-24 bg-yellow-400 mx-auto mt-2 rounded-full"></div>
        </div>
        <div id="course-list" class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Skeleton cards -->
            {[1,2,3].map(() => (
                <div class="bg-gray-100 rounded-2xl h-72 animate-pulse border-2 border-gray-200"></div>
            ))}
        </div>
    </section>

    <!-- ══════════════════════════════
         CARA DAFTAR
    ═══════════════════════════════ -->
    <section id="cara-daftar" class="max-w-5xl mx-auto px-4 md:px-6 py-20">
        <div class="bg-primary p-1 rounded-3xl rotate-1">
            <div class="bg-white rounded-[1.4rem] p-10 -rotate-1 border-4 border-gray-900">
                <h2 class="text-3xl font-black mb-10 text-center italic text-primary">Gampang Banget Buat Gabung!</h2>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="text-center">
                        <div class="w-16 h-16 bg-yellow-400 rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-4 border-4 border-gray-900">1</div>
                        <h4 class="font-bold text-lg mb-1">Pilih Kelas</h4>
                        <p class="text-sm text-gray-500">Cari kursus yang sesuai minat dan levelmu.</p>
                    </div>
                    <div class="text-center">
                        <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-4 border-4 border-gray-900 text-white">2</div>
                        <h4 class="font-bold text-lg mb-1">Pembayaran</h4>
                        <p class="text-sm text-gray-500">Selesaikan transaksi secara aman & cepat.</p>
                    </div>
                    <div class="text-center">
                        <div class="w-16 h-16 bg-green-400 rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-4 border-4 border-gray-900 text-white">3</div>
                        <h4 class="font-bold text-lg mb-1">Mulai Belajar</h4>
                        <p class="text-sm text-gray-500">Akses modul dan kerjakan kuis interaktifnya!</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════
         FAQ
    ═══════════════════════════════ -->
    <section id="bantuan" class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="text-3xl font-black text-center mb-10 text-gray-900">Sering Ditanyakan (FAQ)</h2>
        <div class="space-y-4">
            <details class="group bg-white border-4 border-gray-900 rounded-2xl p-4 cursor-pointer open:bg-blue-50 transition-colors">
                <summary class="flex justify-between items-center font-black text-lg text-gray-700 list-none">
                    Apa itu LPIA LMS?
                    <i class="fas fa-chevron-down group-open:rotate-180 transition-transform"></i>
                </summary>
                <p class="mt-4 font-medium text-gray-600 border-t-2 border-dashed border-gray-200 pt-4">
                    LPIA LMS adalah platform belajar kursus yang menggunakan sistem manajemen pembelajaran modern dengan tampilan menyenangkan ala "Back to School".
                </p>
            </details>
            <details class="group bg-white border-4 border-gray-900 rounded-2xl p-4 cursor-pointer open:bg-blue-50 transition-colors">
                <summary class="flex justify-between items-center font-black text-lg text-gray-700 list-none">
                    Bagaimana cara mendapatkan sertifikat?
                    <i class="fas fa-chevron-down group-open:rotate-180 transition-transform"></i>
                </summary>
                <p class="mt-4 font-medium text-gray-600 border-t-2 border-dashed border-gray-200 pt-4">
                    Setelah menyelesaikan semua modul dan lulus ujian, kamu bisa mendownload sertifikat otomatis dalam format PDF.
                </p>
            </details>
        </div>
    </section>

</Layout>