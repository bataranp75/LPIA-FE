---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LPIA - Sertifikasi & Kursus Bahasa Profesional" navOverHero={true}>
  <!-- ───────── HERO ───────── -->
  <section id="hero-section" class="relative overflow-hidden bg-gradient-to-br from-[#0A2540] via-[#0F3B66] to-[#114B7F]">
    <div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 top-1/3 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl"></div>
    <div class="relative mx-auto flex max-w-7xl flex-col gap-10 px-4 pb-24 pt-32 md:px-6 lg:flex-row lg:items-center lg:gap-16 lg:pb-28 lg:pt-36">
      <div class="max-w-2xl flex-1">
        <h1 id="hero-title" class="text-4xl font-normal leading-[1.05] tracking-[-0.05em] text-white md:text-6xl">
          Tingkatkan Kompetensi Anda Bersama <span class="text-[#E25822]">LPIA</span>
        </h1>
        <p id="hero-subtitle" class="mt-6 max-w-xl text-base leading-7 text-blue-100/90 md:text-lg">Akses kurikulum berstandar industri dan materi interaktif untuk mempercepat perkembangan karir dan keahlian Anda.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a id="hero-primary" href="#kursus" class="inline-flex h-14 items-center justify-center rounded-full bg-[#E25822] px-8 font-semibold text-white shadow-lg shadow-orange-900/20 transition-all hover:scale-105 hover:bg-[#C84A1B]"><span data-hero="primary_text">Mulai Belajar</span></a>
          <a id="hero-secondary" href="#cara-daftar" class="inline-flex h-14 items-center justify-center rounded-full border border-white/30 px-8 font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10"><span data-hero="secondary_text">Lihat Program</span></a>
        </div>
      </div>
      <div class="w-full flex-1">
        <div class="hero-card-ring aspect-[4/3] overflow-hidden rounded-3xl bg-[#0F3B66]">
          <img id="hero-banner" src="https://placehold.co/1200x900/0F3B66/FFFFFF?text=LPIA" alt="Banner LPIA" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── STATS FLOATING BAR ───────── -->
  <section class="relative z-20 mx-auto -mt-10 max-w-7xl px-4 md:px-6">
    <div id="trust-list" class="grid grid-cols-2 gap-4 rounded-2xl border border-blue-100 bg-white/80 p-6 shadow-xl backdrop-blur-md md:grid-cols-4">
      <div class="text-center"><div class="bg-gradient-to-r from-[#0F3B66] to-[#E25822] bg-clip-text font-extrabold text-2xl text-transparent md:text-3xl">20+</div><div class="mt-1 text-xs text-[#4A4E57]">Tahun Pengalaman</div></div>
      <div class="text-center"><div class="bg-gradient-to-r from-[#0F3B66] to-[#E25822] bg-clip-text font-extrabold text-2xl text-transparent md:text-3xl">10.000+</div><div class="mt-1 text-xs text-[#4A4E57]">Alumni</div></div>
      <div class="text-center"><div class="bg-gradient-to-r from-[#0F3B66] to-[#E25822] bg-clip-text font-extrabold text-2xl text-transparent md:text-3xl">50+</div><div class="mt-1 text-xs text-[#4A4E57]">Program Belajar</div></div>
      <div class="text-center"><div class="bg-gradient-to-r from-[#0F3B66] to-[#E25822] bg-clip-text font-extrabold text-2xl text-transparent md:text-3xl">4.9</div><div class="mt-1 text-xs text-[#4A4E57]">Kepuasan Siswa</div></div>
    </div>
  </section>

  <!-- ───────── PROMO ───────── -->
  <section id="promo-section" class="hidden bg-gradient-to-r from-[#EFF6FF]/80 via-[#F8FAFC] to-[#EFF6FF]/80 py-16 md:py-20"><div id="promo-list" class="mx-auto grid max-w-7xl grid-cols-1 gap-5 px-4 md:px-6"></div></section>

  <!-- ───────── REKOMENDASI ───────── -->
  <section id="recommendation-section" class="scroll-mt-24 bg-gradient-to-r from-[#EFF6FF]/80 via-[#F8FAFC] to-[#EFF6FF]/80 py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="max-w-2xl"><h2 class="text-3xl font-normal tracking-[-0.04em] text-[#0A2540] md:text-5xl">Rekomendasi untuk kamu</h2><p class="mt-4 text-[#4A4E57]">Pilih preferensi belajar untuk menemukan kursus yang relevan.</p></div>
      <div id="recommendation-content" class="mt-10"></div>
    </div>
  </section>

  <!-- ───────── KENAPA BELAJAR ───────── -->
  <section class="bg-gradient-to-b from-white via-sky-50/70 to-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="max-w-2xl"><h2 class="text-3xl font-normal tracking-[-0.04em] text-[#0A2540] md:text-5xl">Kenapa Belajar di LPIA?</h2></div>
      <div id="features-list" class="mt-10 grid gap-5 md:grid-cols-3">
                  <div class="rounded-2xl border border-slate-200/60 bg-white/70 p-6 ring-1 ring-blue-100 backdrop-blur-sm transition-all hover:bg-white hover:shadow-md"><div class="mb-6 inline-flex rounded-xl bg-blue-100/80 p-3 text-[#0F3B66]"><i class="fas fa-certificate text-xl"></i></div><h3 class="text-lg font-semibold text-[#0A2540]">Kurikulum Terarah</h3><p class="mt-3 text-sm leading-6 text-[#4A4E57]">Materi belajar disusun untuk mendukung target kompetensi Anda.</p></div>
                  <div class="rounded-2xl border border-slate-200/60 bg-white/70 p-6 ring-1 ring-blue-100 backdrop-blur-sm transition-all hover:bg-white hover:shadow-md"><div class="mb-6 inline-flex rounded-xl bg-blue-100/80 p-3 text-[#0F3B66]"><i class="fas fa-chalkboard-user text-xl"></i></div><h3 class="text-lg font-semibold text-[#0A2540]">Pengajar Berpengalaman</h3><p class="mt-3 text-sm leading-6 text-[#4A4E57]">Belajar bersama pengajar yang siap mendampingi perkembangan Anda.</p></div>
                  <div class="rounded-2xl border border-slate-200/60 bg-white/70 p-6 ring-1 ring-blue-100 backdrop-blur-sm transition-all hover:bg-white hover:shadow-md"><div class="mb-6 inline-flex rounded-xl bg-blue-100/80 p-3 text-[#0F3B66]"><i class="fas fa-laptop text-xl"></i></div><h3 class="text-lg font-semibold text-[#0A2540]">Belajar Fleksibel</h3><p class="mt-3 text-sm leading-6 text-[#4A4E57]">Akses pilihan program yang dapat menyesuaikan kebutuhan belajar Anda.</p></div>
      </div>
    </div>
  </section>

  <!-- ───────── PROGRAM KURSUS ───────── -->
  <section id="kursus" class="scroll-mt-24 bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between"><div class="max-w-2xl"><h2 class="text-3xl font-normal tracking-[-0.04em] text-[#0A2540] md:text-5xl">Program Kursus Unggulan</h2><p class="mt-4 text-[#4A4E57]">Pilih program yang dirancang untuk kebutuhan profesional Anda.</p></div><div class="flex items-center gap-3"><button id="course-carousel-prev" type="button" aria-label="Kursus sebelumnya" class="hidden h-11 w-11 rounded-full border border-slate-200 text-[#0A2540] disabled:opacity-40 md:inline-flex md:items-center md:justify-center"><i class="fas fa-chevron-left"></i></button><button id="course-carousel-next" type="button" aria-label="Kursus berikutnya" class="hidden h-11 w-11 rounded-full border border-slate-200 text-[#0A2540] disabled:opacity-40 md:inline-flex md:items-center md:justify-center"><i class="fas fa-chevron-right"></i></button><a href="/courses" class="text-sm font-semibold text-[#0F3B66]">Lihat semua</a></div></div>
      <div id="course-list" class="course-scrollbar mt-10 flex gap-5 overflow-x-auto pb-4">{[1,2,3,4].map(() => (<div class="h-[25rem] w-72 shrink-0 animate-pulse rounded-2xl border border-slate-200 bg-white/70 sm:w-80"></div>))}</div>
    </div>
  </section>

  <!-- ───────── 3 LANGKAH ───────── -->
  <section id="cara-daftar" class="scroll-mt-24 mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
    <div class="rounded-3xl border border-blue-400/20 bg-gradient-to-r from-[#0A2540] via-[#0F3B66] to-[#0A2540] p-8 text-white shadow-2xl md:p-12">
      <h2 class="max-w-xl text-3xl font-normal tracking-[-0.04em] md:text-5xl">Mulai belajar dalam tiga langkah</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div><div class="font-black text-2xl text-[#E25822]">01</div><h3 class="mt-3 text-lg font-semibold">Pilih Kelas</h3><p class="mt-3 text-sm leading-6 text-blue-100/80">Temukan kursus berdasarkan target dan kemampuan awal Anda.</p></div>
        <div><div class="font-black text-2xl text-[#E25822]">02</div><h3 class="mt-3 text-lg font-semibold">Selesaikan Pembayaran</h3><p class="mt-3 text-sm leading-6 text-blue-100/80">Pilih metode pembayaran yang tersedia secara aman.</p></div>
        <div><div class="font-black text-2xl text-[#E25822]">03</div><h3 class="mt-3 text-lg font-semibold">Mulai Belajar</h3><p class="mt-3 text-sm leading-6 text-blue-100/80">Akses materi dan selesaikan progres belajar Anda.</p></div>
      </div>
    </div>
  </section>

  <!-- ───────── ALUMNI ───────── -->
  <section id="alumni-section" class="hidden bg-gradient-to-b from-[#F8FAFC] to-[#EFF6FF]/50 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-10 flex items-end justify-between gap-4"><h2 class="text-3xl font-normal tracking-[-0.04em] text-[#0A2540]">Alumni LPIA</h2><div class="hidden gap-2 md:flex"><button id="alumni-prev" type="button" aria-label="Testimoni sebelumnya" class="h-10 w-10 rounded-full border border-blue-100 bg-white text-[#0A2540]"><i class="fas fa-chevron-left"></i></button><button id="alumni-next" type="button" aria-label="Testimoni berikutnya" class="h-10 w-10 rounded-full border border-blue-100 bg-white text-[#0A2540]"><i class="fas fa-chevron-right"></i></button></div></div>
      <div id="alumni-track" class="course-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4"></div>
    </div>
  </section>

  <!-- ───────── LOKASI / BRANCH ───────── -->
  <section id="branch-section" class="hidden mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-10 overflow-hidden rounded-3xl border border-blue-400/20 bg-gradient-to-br from-[#0A2540] to-[#0F3B66] p-8 text-white shadow-2xl md:p-12 lg:grid-cols-2 lg:items-center">
      <div><h2 id="branch-name" class="text-3xl font-normal tracking-[-0.04em]">LPIA</h2><p id="branch-tagline" class="mt-3 font-semibold text-blue-200"></p><p id="branch-description" class="mt-5 leading-relaxed text-blue-100/80"></p><div class="mt-7 space-y-3 text-sm text-blue-50"><p><i class="fas fa-location-dot mr-3 text-blue-300"></i><span id="branch-address"></span></p><p><i class="fas fa-clock mr-3 text-blue-300"></i><span id="branch-hours"></span></p><p><i class="fas fa-phone mr-3 text-blue-300"></i><span id="branch-phone"></span></p><p id="branch-wa-wrap" class="hidden"><i class="fab fa-whatsapp mr-3 text-blue-300"></i><span id="branch-whatsapp"></span></p></div><a id="branch-maps" href="#" target="_blank" rel="noreferrer" class="hidden mt-8 inline-flex h-11 items-center rounded-full bg-[#E25822] px-5 font-semibold text-white hover:bg-[#C84A1B]">Lihat di Maps</a></div>
      <div class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-[#0A2540]"><img id="branch-photo" src="" alt="Cabang LPIA" class="hidden h-full w-full object-cover" /><div id="branch-photo-placeholder" class="absolute inset-0 flex items-center justify-center text-5xl text-blue-300/60"><i class="fas fa-school"></i></div></div>
    </div>
  </section>

  <!-- ───────── BANTUAN / FAQ ───────── -->
  <section id="bantuan" class="scroll-mt-24 mx-auto max-w-3xl bg-gradient-to-b from-white to-teal-50/50 px-4 py-16 md:px-6 md:py-24">
    <h2 class="text-3xl font-normal tracking-[-0.04em] text-[#0A2540] md:text-center md:text-5xl">Pertanyaan Seputar LPIA</h2>
    <div id="faq-accordion" class="mt-10 divide-y divide-blue-100 border-y border-blue-100">
      <details class="group py-5"><summary class="flex cursor-pointer list-none justify-between gap-4 font-semibold text-[#0A2540]">Apa itu Platform LPIA LMS?<i class="fas fa-chevron-down text-[#7A7F8A] transition-transform group-open:rotate-180"></i></summary><p class="mt-4 text-sm leading-6 text-[#4A4E57]">LPIA LMS adalah platform pembelajaran digital resmi untuk siswa dan profesional.</p></details>
      <details class="group py-5"><summary class="flex cursor-pointer list-none justify-between gap-4 font-semibold text-[#0A2540]">Bagaimana prosedur mendapatkan sertifikat?<i class="fas fa-chevron-down text-[#7A7F8A] transition-transform group-open:rotate-180"></i></summary><p class="mt-4 text-sm leading-6 text-[#4A4E57]">Sertifikat diterbitkan setelah seluruh modul dan evaluasi akhir diselesaikan sesuai ketentuan program.</p></details>
    </div>
  </section>

  <!-- ───────── CTA ───────── -->
  <section id="cta-section" class="mx-auto max-w-7xl px-4 pb-16 md:px-6 md:pb-24">
    <div class="rounded-3xl border border-blue-400/20 bg-gradient-to-r from-[#0A2540] via-[#0F3B66] to-[#0A2540] p-8 text-center text-white shadow-2xl md:px-14 md:py-16">
      <h2 id="cta-title" class="text-3xl font-normal tracking-[-0.04em] md:text-5xl">Siap Memulai Perjalanan Belajar?</h2>
      <p id="cta-subtitle" class="mx-auto mt-4 max-w-2xl text-blue-100/80">Temukan program belajar yang tepat dan kembangkan kompetensi Anda bersama LPIA.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a id="cta-primary" href="#kursus" class="inline-flex h-14 items-center justify-center rounded-full bg-[#E25822] px-8 font-semibold text-white shadow-lg shadow-orange-900/20 transition-all hover:scale-105 hover:bg-[#C84A1B]"><span id="cta-primary-text">Lihat Kursus</span></a><a id="cta-secondary" href="/login" class="inline-flex h-14 items-center justify-center rounded-full border border-white/30 px-8 font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10"><span id="cta-secondary-text">Daftar Sekarang</span></a></div>
    </div>
  </section>
</Layout>
