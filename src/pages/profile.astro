---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profil Saya | LPIA">
  <div id="profile-page" class="min-h-screen bg-[#F5F3ED] pb-20 pt-28">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <section id="profile-banner" class="flex items-center gap-5 rounded-3xl border border-[#E5E4DE] bg-white p-6 md:p-8">
        <div id="user-display-avatar" class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#F5F3ED] text-2xl text-[#4A4E57]"><i class="fas fa-user"></i></div>
        <div>
          <h1 id="user-display-name" class="text-2xl font-semibold tracking-[-0.03em] text-white md:text-3xl">Memuat...</h1>
          <div id="user-display-level-badge" class="mt-2 inline-flex items-center gap-2 rounded-full bg-[#F5F3ED] px-3 py-1 text-xs font-semibold text-[#4A4E57]"><i class="fas fa-shield-alt"></i> <span id="user-level-text">...</span></div>
        </div>
      </section>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-4">
        <div class="lg:col-span-1">
          <div class="sticky top-28 rounded-3xl border border-[#E5E4DE] bg-white p-2">
            <button id="mobile-menu-toggle" class="flex w-full items-center justify-between rounded-2xl bg-[#F5F3ED] px-4 py-3 text-left text-sm font-semibold text-[#1A1D20] lg:hidden"><span id="mobile-menu-text" class="flex items-center gap-3"><i class="fas fa-user-cog w-5 text-center"></i>Pengaturan Profil</span><i class="fas fa-chevron-down transition-transform duration-300" id="mobile-menu-icon"></i></button>
            <nav class="hidden flex-col lg:flex" id="profile-nav">
              <button data-target="section-umum" data-text="Pengaturan Profil" data-icon="fa-user-cog" class="profile-tab flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-[#0F4C81] bg-blue-50"><i class="fas fa-user-cog w-5 text-center"></i>Pengaturan Profil</button>
              <button data-target="section-kursus" data-text="Kursus Saya" data-icon="fa-play-circle" class="profile-tab flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-[#4A4E57] hover:bg-[#F5F3ED]"><i class="fas fa-play-circle w-5 text-center"></i>Kursus Saya</button>
              <button data-target="section-sertifikat" data-text="Sertifikat" data-icon="fa-certificate" class="profile-tab flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-[#4A4E57] hover:bg-[#F5F3ED]"><i class="fas fa-certificate w-5 text-center"></i>Sertifikat</button>
              <button data-target="section-riwayat" data-text="Riwayat Transaksi" data-icon="fa-history" class="profile-tab flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-[#4A4E57] hover:bg-[#F5F3ED]"><i class="fas fa-history w-5 text-center"></i>Riwayat Transaksi</button>
              <div class="my-2 h-px bg-[#F5F3ED]"></div>
              <button id="btn-logout-profile" class="flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-red-600 hover:bg-red-50"><i class="fas fa-sign-out-alt w-5 text-center"></i>Keluar Akun</button>
              <button data-target="section-danger" data-text="Danger Zone" data-icon="fa-exclamation-triangle" class="profile-tab mt-1 flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold text-red-600 hover:bg-red-50"><i class="fas fa-exclamation-triangle w-5 text-center"></i>Danger Zone</button>
            </nav>
          </div>
        </div>
        <div class="lg:col-span-3 space-y-6">
          <div id="section-umum" class="profile-section block rounded-3xl border border-[#E5E4DE] bg-white p-6 md:p-8">
            <h2 class="text-xl font-semibold text-[#1A1D20]">Informasi Profil</h2>
            <form id="form-update-profile" class="mt-6 max-w-md space-y-5">
              <div class="space-y-3">
                <label class="block text-sm font-semibold text-[#1A1D20]">Foto Profil</label>
                <div class="profile-photo-preview flex h-20 w-20 items-center justify-center overflow-hidden rounded-full border border-[#E5E4DE] bg-[#F5F3ED]"><img id="avatarPreview" src="/default-avatar.png" alt="Foto Profil" class="h-full w-full object-cover"></div>
                <div class="mt-3"><label for="avatarInput" class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-full border border-[#E5E4DE] bg-white px-4 text-sm font-semibold text-[#1A1D20] hover:border-[#0F4C81] hover:text-[#0F4C81]"><i class="fas fa-upload text-[#0F4C81]"></i>Pilih Foto</label><span id="avatarFileName" class="ml-3 text-sm text-[#7A7F8A]">Belum ada file dipilih</span><input type="file" id="avatarInput" accept="image/jpeg,image/png,image/jpg" class="hidden" /><p class="mt-2 text-xs text-[#7A7F8A]">Format: JPG/PNG, maksimal 5MB.</p></div>
              </div>
              <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Nama Lengkap</label><input type="text" id="input-full-name" required class="h-12 w-full rounded-xl border border-[#E5E4DE] px-4 text-sm text-[#1A1D20] outline-none placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]" placeholder="Nama Anda"></div>
              <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Email (Tidak dapat diubah)</label><input type="email" id="input-email" disabled class="h-12 w-full cursor-not-allowed rounded-xl border border-[#E5E4DE] bg-[#F5F3ED] px-4 text-sm text-[#7A7F8A]"></div>
              <div class="rounded-2xl border border-[#E5E4DE] bg-[#F5F3ED] p-5">
                <h3 class="text-base font-semibold text-[#1A1D20]">Ubah Password</h3>
                <div class="mt-4 space-y-4">
                  <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Password Baru</label><input type="password" id="newPassword" placeholder="Masukkan password baru" class="h-12 w-full rounded-xl border border-[#E5E4DE] bg-white px-4 text-sm outline-none placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]"></div>
                  <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Konfirmasi Password</label><input type="password" id="confirmPassword" placeholder="Ulangi password baru" class="h-12 w-full rounded-xl border border-[#E5E4DE] bg-white px-4 text-sm outline-none placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]"></div>
                  <button type="button" id="changePasswordBtn" class="inline-flex h-11 items-center rounded-full bg-[#1A1D20] px-5 text-sm font-semibold text-white hover:bg-[#2A2D33]">Ubah Password</button>
                </div>
              </div>
              <button type="submit" id="btn-save-profile" class="inline-flex h-11 items-center rounded-full bg-[#0F4C81] px-6 font-semibold text-white hover:bg-[#0A3A63]">Simpan Perubahan</button>
            </form>
          </div>

          <template id="search-filter-template"><div class="mb-6 flex flex-col gap-4 md:flex-row"><div class="relative flex-grow"><i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-[#7A7F8A]"></i><input type="text" placeholder="Cari..." class="search-input h-12 w-full rounded-xl border border-[#E5E4DE] pl-11 pr-4 outline-none focus:border-2 focus:border-[#0F4C81]"></div></div></template>

          <div id="section-kursus" class="profile-section hidden rounded-3xl border border-[#E5E4DE] bg-white p-6 md:p-8"><h2 class="mb-6 text-xl font-semibold text-[#1A1D20]">Kursus Aktif</h2><div id="search-container-kursus"></div><div id="my-courses-list" class="grid grid-cols-1 gap-6 md:grid-cols-2"></div></div>
          <div id="section-sertifikat" class="profile-section hidden rounded-3xl border border-[#E5E4DE] bg-white p-6 md:p-8"><h2 class="mb-6 text-xl font-semibold text-[#1A1D20]">Sertifikat Kelulusan</h2><div id="search-container-sertifikat"></div><div id="my-certificates-list" class="space-y-4"></div></div>
          <div id="section-riwayat" class="profile-section hidden rounded-3xl border border-[#E5E4DE] bg-white p-6 md:p-8"><h2 class="mb-6 text-xl font-semibold text-[#1A1D20]">Log Transaksi</h2><div id="search-container-riwayat"></div><div id="transaction-cards" class="grid grid-cols-1 gap-4 md:grid-cols-2"></div></div>
          <div id="section-danger" class="profile-section hidden rounded-3xl border border-red-200 bg-red-50 p-6 md:p-8"><h2 class="text-xl font-semibold text-red-700">Danger Zone</h2><p class="mt-2 text-sm text-red-600">Tindakan di bawah ini bersifat permanen.</p><div class="mt-6 flex flex-col gap-4 rounded-2xl border border-red-200 bg-white p-5 md:flex-row md:items-center md:justify-between"><div><h4 class="font-semibold text-[#1A1D20]">Hapus Akun</h4><p class="mt-1 text-xs text-[#4A4E57]">Semua progres dan sertifikat akan dihapus secara permanen.</p></div><button id="btn-delete-account" class="inline-flex h-11 items-center rounded-full bg-red-700 px-5 text-sm font-semibold text-white hover:bg-red-800">Hapus Akun Saya</button></div></div>
        </div>
      </div>
    </div>
  </div>
</Layout>
