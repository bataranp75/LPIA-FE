---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Masuk / Daftar | LPIA">
  <section class="flex min-h-screen items-center justify-center bg-gradient-to-br from-sky-100 via-[#F0FDF4] to-[#E0F2FE] px-4 py-24">
    <div class="w-full max-w-md rounded-3xl border border-blue-100 bg-white p-6 shadow-2xl shadow-blue-900/10 sm:p-10">
      <div class="mb-8">
        <a href="/" class="text-xl font-semibold tracking-[-0.04em] text-[#1A1D20]">LPIA<span class="text-[#0F4C81]">.</span></a>
        <h1 id="auth-title" class="mt-8 text-3xl font-normal tracking-[-0.04em] text-[#1A1D20]">Masuk ke LPIA</h1>
        <p class="mt-3 text-sm leading-6 text-[#4A4E57]">Akses modul interaktif dan lanjutkan progres belajar Anda.</p>
      </div>
      <div class="mb-6 grid grid-cols-2 gap-1 rounded-full bg-[#F5F3ED] p-1">
        <button type="button" id="tab-user" class="auth-tab h-10 rounded-full bg-white px-3 text-sm font-semibold text-[#0F4C81]">Login User</button>
        <button type="button" id="tab-staff" class="auth-tab h-10 rounded-full px-3 text-sm font-semibold text-[#4A4E57] hover:text-[#1A1D20]">Guru / Admin</button>
      </div>
      <form id="auth-form" class="space-y-5">
        <div id="name-field" class="hidden"><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Nama Lengkap</label><input type="text" name="full_name" class="h-12 w-full rounded-xl border border-[#E5E4DE] px-4 text-sm text-[#1A1D20] outline-none transition-colors placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]" placeholder="Masukkan nama lengkap"></div>
        <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Email</label><input type="email" name="email" required class="h-12 w-full rounded-xl border border-[#E5E4DE] px-4 text-sm text-[#1A1D20] outline-none transition-colors placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]" placeholder="contoh@email.com"></div>
        <div><label class="mb-2 block text-sm font-semibold text-[#1A1D20]">Password</label><input type="password" name="password" required class="h-12 w-full rounded-xl border border-[#E5E4DE] px-4 text-sm text-[#1A1D20] outline-none transition-colors placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]" placeholder="••••••••"></div>
        <button type="submit" id="submit-btn" class="mt-2 inline-flex h-12 w-full items-center justify-center rounded-full bg-[#0F4C81] px-6 text-base font-semibold text-white transition-colors hover:bg-[#0A3A63] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0F4C81] focus-visible:ring-offset-2">Masuk</button>
      </form>
      <div id="auth-toggle-container" class="mt-8 border-t border-[#F5F3ED] pt-6 text-center text-sm text-[#4A4E57]">Belum punya akun? <a href="#" class="toggle-auth font-semibold text-[#0F4C81] hover:underline">Daftar Sekarang</a></div>
    </div>
  </section>
</Layout>
