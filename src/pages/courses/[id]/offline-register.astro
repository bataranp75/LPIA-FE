---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Daftar Kelas Offline">
  <div id="offline-registration-page" class="min-h-screen bg-slate-50 pt-28 pb-12 md:pb-16">
    <div class="mx-auto max-w-5xl px-4 md:px-6">
      <div class="mb-8 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-blue-600">Pendaftaran Offline</p>
        <h1 id="page-title" class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">Daftar Kelas Offline</h1>
        <p id="page-subtitle" class="mt-3 text-slate-600">Lengkapi formulir untuk melanjutkan pendaftaran.</p>
      </div>

      <div id="form-container" class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
        <div class="animate-pulse space-y-4" id="loading-state">
          <div class="h-5 w-1/3 rounded bg-slate-200"></div>
          <div class="h-12 rounded-2xl bg-slate-100"></div>
          <div class="h-12 rounded-2xl bg-slate-100"></div>
          <div class="h-12 rounded-2xl bg-slate-100"></div>
        </div>
      </div>
    </div>
  </div>
  <script type="module" src="/src/scripts/dom/admin/offlineRegistrationPage.js"></script>
</Layout>
