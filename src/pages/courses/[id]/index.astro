---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Detail Kursus | LPIA">
  <script is:inline type="text/javascript" src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key="SB-Mid-client-XXXXX"></script>

  <div id="course-detail-page" class="min-h-screen bg-slate-50 pb-24">
    <section class="relative overflow-hidden bg-slate-950 pt-32 pb-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(59,130,246,0.25),_transparent_35%),radial-gradient(circle_at_top_right,_rgba(99,102,241,0.22),_transparent_30%),linear-gradient(to_bottom,rgba(15,23,42,0.95),rgba(15,23,42,0.88))]"></div>
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
        <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm font-medium text-slate-300">
          <a href="/" class="transition-colors hover:text-white">Home</a>
          <span class="text-slate-500">/</span>
          <a href="/courses" class="transition-colors hover:text-white">Kursus</a>
          <span class="text-slate-500">/</span>
          <span id="bc-course-title" class="text-slate-100">Memuat...</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-3 lg:items-end">
          <div class="max-w-4xl lg:col-span-2">
            <div class="mb-4 flex flex-wrap gap-3">
              <span id="hero-category" class="inline-flex items-center rounded-full bg-blue-500 px-3 py-1 text-xs font-black uppercase tracking-[0.28em] text-white shadow-sm">
                Kategori
              </span>
              <span id="hero-delivery-type" class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-[0.28em] text-white backdrop-blur">
                Online
              </span>
              <span id="hero-learning-type" class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-[0.28em] text-white backdrop-blur">
                Regular
              </span>
              <span id="hero-level" class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-[0.28em] text-white backdrop-blur">
                Beginner
              </span>
            </div>

            <h1 id="hero-title" class="text-3xl font-black leading-tight tracking-tight text-white md:text-5xl">
              <i class="fas fa-spinner fa-spin text-blue-400"></i> Memuat Detail Kursus...
            </h1>

            <p id="hero-desc" class="mt-5 max-w-3xl text-base leading-8 text-slate-300 md:text-lg">
              Mohon tunggu sebentar, kami sedang mengambil data kursus terbaik untuk Anda.
            </p>

            <div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold text-slate-200">
              <div class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur">
                <i class="fas fa-star text-yellow-400"></i>
                <span>4.9 Rating</span>
              </div>
              <div class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur">
                <i class="fas fa-users text-sky-300"></i>
                <span><span id="hero-students">...</span> Siswa</span>
              </div>
              <div class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur">
                <i class="fas fa-book-open text-emerald-300"></i>
                <span><span id="hero-modules-count">...</span> Modul</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="relative z-20 mx-auto -mt-10 max-w-7xl px-4 md:px-6">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="space-y-8 lg:col-span-2">
          <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <div class="border-b border-slate-100 pb-5">
              <p class="text-xs font-black uppercase tracking-[0.28em] text-violet-600">Ringkasan</p>
              <h2 class="mt-2 text-2xl font-black text-slate-900">Tentang Kursus Ini</h2>
            </div>

            <div id="content-desc" class="prose prose-slate mt-6 max-w-none text-slate-600 leading-relaxed">
              <div class="animate-pulse h-4 bg-slate-200 rounded w-full mb-2"></div>
              <div class="animate-pulse h-4 bg-slate-200 rounded w-5/6 mb-2"></div>
              <div class="animate-pulse h-4 bg-slate-200 rounded w-4/6"></div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2" id="detail-tag-list">
              <span class="rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-500 ring-1 ring-slate-200">Tags</span>
            </div>
          </section>

          <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <div class="mb-6 flex items-center justify-between gap-4 border-b border-slate-100 pb-4">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.28em] text-blue-600">Kurikulum</p>
                <h2 class="mt-2 text-2xl font-black text-slate-900">Kurikulum Belajar</h2>
              </div>
              <span id="module-badge" class="rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-blue-700">
                ... Modul
              </span>
            </div>

            <div id="module-list" class="space-y-3">
              <div class="animate-pulse h-16 w-full rounded-2xl border border-slate-200 bg-slate-100"></div>
              <div class="animate-pulse h-16 w-full rounded-2xl border border-slate-200 bg-slate-100"></div>
            </div>
          </section>
        </div>

        <aside class="lg:sticky lg:top-28 h-fit">
          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl">
            <div class="relative h-56 bg-slate-100">
              <img id="card-thumbnail" src="" alt="Thumbnail" class="h-full w-full object-cover opacity-0 transition-opacity duration-500" />
              <div id="card-thumbnail-skeleton" class="absolute inset-0 flex items-center justify-center bg-slate-100 text-5xl text-slate-300">
                <i class="fas fa-image"></i>
              </div>
            </div>

            <div class="p-6">
              <div class="text-sm font-bold uppercase tracking-[0.28em] text-slate-400">Harga Spesial</div>
              <div id="card-price" class="mt-2 text-4xl font-black text-slate-900">Rp ...</div>

              <div id="course-info-grid" class="mt-6 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-2xl bg-slate-50 p-4">
                  <div class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Kategori</div>
                  <div id="side-category" class="mt-2 font-black text-slate-900">-</div>
                </div>
                <div class="rounded-2xl bg-slate-50 p-4">
                  <div class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Level</div>
                  <div id="side-level" class="mt-2 font-black text-slate-900">-</div>
                </div>
                <div class="rounded-2xl bg-slate-50 p-4">
                  <div class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Metode</div>
                  <div id="side-delivery" class="mt-2 font-black text-slate-900">-</div>
                </div>
                <div class="rounded-2xl bg-slate-50 p-4">
                  <div class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Jenis Kelas</div>
                  <div id="side-learning" class="mt-2 font-black text-slate-900">-</div>
                </div>
              </div>

              <div id="course-teacher-box" class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Pengajar</div>
                <div id="side-teacher" class="mt-2 font-black text-slate-900">-</div>
              </div>

              <div id="cta-container" class="mt-6">
                <div class="animate-pulse h-12 rounded-2xl bg-blue-200/30"></div>
              </div>

              <div class="mt-6 space-y-3 border-t border-slate-100 pt-6" id="course-benefits">
                <div class="flex items-center gap-3 text-sm text-slate-600">
                  <i class="fas fa-infinity w-5 text-blue-600"></i>
                  <span>Akses materi selamanya</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-600">
                  <i class="fas fa-house-laptop w-5 text-blue-600"></i>
                  <span>Belajar kapan saja</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-600">
                  <i class="fas fa-certificate w-5 text-blue-600"></i>
                  <span>Sertifikat</span>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>