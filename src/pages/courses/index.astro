---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Katalog Kursus | LPIA">
  <main class="min-h-screen bg-white pb-24 pt-28">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <section class="pb-10">
        <h1 class="text-4xl font-normal tracking-[-0.05em] text-[#1A1D20] md:text-6xl">Katalog Kursus</h1>
        <p class="mt-4 max-w-2xl text-[#4A4E57]">Filter berdasarkan kategori, level, metode belajar, dan jenis kelas untuk menemukan kursus yang relevan.</p>
      </section>
      <section class="flex flex-col gap-3 border-y border-[#E5E4DE] py-5 lg:flex-row lg:items-center">
        <div class="relative flex-1"><i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-[#7A7F8A]"></i><input type="text" id="course-search-input" placeholder="Cari kursus..." class="h-12 w-full rounded-xl border border-[#E5E4DE] pl-11 pr-4 text-sm text-[#1A1D20] outline-none placeholder:text-[#7A7F8A] focus:border-2 focus:border-[#0F4C81]" /></div>
        <div class="grid grid-cols-2 gap-3 lg:flex">
          <div class="relative"><select id="course-category-filter" class="h-12 w-full cursor-pointer appearance-none rounded-xl border border-[#E5E4DE] bg-white pl-4 pr-10 text-sm font-medium text-[#1A1D20] outline-none focus:border-2 focus:border-[#0F4C81] lg:w-44"><option value="all">Semua Kategori</option><option value="Komputer">Komputer</option><option value="Bahasa Inggris">Bahasa Inggris</option><option value="Bahasa Asing">Bahasa Asing</option><option value="Desain">Desain</option><option value="Programming">Programming</option><option value="Marketing">Marketing</option><option value="Akuntansi">Akuntansi</option><option value="Bimbingan Belajar">Bimbingan Belajar</option></select><i class="fas fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-[#7A7F8A]"></i></div>
          <div class="relative"><select id="course-level-filter" class="h-12 w-full cursor-pointer appearance-none rounded-xl border border-[#E5E4DE] bg-white pl-4 pr-10 text-sm font-medium text-[#1A1D20] outline-none focus:border-2 focus:border-[#0F4C81] lg:w-36"><option value="all">Semua Level</option><option value="Beginner">Beginner</option><option value="Intermediate">Intermediate</option><option value="Advanced">Advanced</option></select><i class="fas fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-[#7A7F8A]"></i></div>
          <div class="relative"><select id="course-delivery-filter" class="h-12 w-full cursor-pointer appearance-none rounded-xl border border-[#E5E4DE] bg-white pl-4 pr-10 text-sm font-medium text-[#1A1D20] outline-none focus:border-2 focus:border-[#0F4C81] lg:w-36"><option value="all">Semua Metode</option><option value="Online">Online</option><option value="Offline">Offline</option></select><i class="fas fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-[#7A7F8A]"></i></div>
          <div class="relative"><select id="course-learning-filter" class="h-12 w-full cursor-pointer appearance-none rounded-xl border border-[#E5E4DE] bg-white pl-4 pr-10 text-sm font-medium text-[#1A1D20] outline-none focus:border-2 focus:border-[#0F4C81] lg:w-36"><option value="all">Semua Jenis</option><option value="Regular">Regular</option><option value="Private">Private</option></select><i class="fas fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-[#7A7F8A]"></i></div>
        </div>
      </section>
      <section class="mt-8"><div id="courses-grid-page" class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4"></div></section>
    </div>
  </main>
</Layout>
